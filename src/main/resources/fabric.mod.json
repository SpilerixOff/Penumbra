  "authors": [
    "SpilerixOff",
    "Penumbra Team"
  ],
  "license": "MIT",
  "icon": "assets/penumbra/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "fr.penumbra.PenumbraMod"
